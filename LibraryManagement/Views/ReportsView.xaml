<UserControl x:Class="LibraryManagement.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Reports &amp; Insights" Style="{StaticResource TitleText}"/><TextBlock Text="Khu vực báo cáo nhanh dành cho thủ thư/quản trị viên" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel></Grid>
        <UniformGrid Columns="4"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="BOOK COPIES" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TotalBooks}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="AVAILABLE" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Available}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="BORROWED" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Borrowed}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="TOTAL FINES" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Fines, StringFormat={}{0:N0} đ}" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,14"><StackPanel><TextBlock Text="Operational Metrics" Style="{StaticResource SectionText}"/><ItemsControl ItemsSource="{Binding Metrics}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,7"><Grid><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Value}" HorizontalAlignment="Right"/></Grid><ProgressBar Maximum="100" Value="{Binding Percentage}" Height="8" Margin="0,6,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Recent Transactions" Style="{StaticResource SectionText}"/><DataGrid ItemsSource="{Binding RecentLoans}" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="LOAN" Binding="{Binding LoanCode}" Width="130"/><DataGridTextColumn Header="READER" Binding="{Binding Reader.FullName}" Width="*"/><DataGridTextColumn Header="DATE" Binding="{Binding BorrowedAt, StringFormat=dd/MM/yyyy}" Width="100"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="95"/></DataGrid.Columns></DataGrid></StackPanel></Border></Grid>
    </StackPanel></ScrollViewer>
</UserControl>

<UserControl x:Class="LibraryManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Tổng quan vận hành thư viện theo thời gian thực" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#111C2E" BorderBrush="#253653" BorderThickness="1" CornerRadius="10" Padding="12,8">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
                </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,0">
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="TOTAL BOOK COPIES" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TotalBooks}" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="đầu sách đang quản lý" Style="{StaticResource MutedText}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="AVAILABLE" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding AvailableBooks}" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="bản sẵn sàng cho mượn" Style="{StaticResource MutedText}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="READERS" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding TotalReaders}" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="độc giả đang hoạt động" Style="{StaticResource MutedText}"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="OVERDUE" Style="{StaticResource MutedText}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding OverdueLoans}" FontSize="30" FontWeight="Bold" Margin="0,8,0,2" Foreground="#FF8D9F"/><TextBlock Text="phiếu cần xử lý" Style="{StaticResource MutedText}"/></StackPanel></Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Most Borrowed Books" Style="{StaticResource SectionText}"/>
                        <TextBlock Text="Các tựa sách có lượt mượn cao nhất" Style="{StaticResource MutedText}" Margin="0,4,0,12"/>
                        <ItemsControl ItemsSource="{Binding TopBooks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Grid.Column="1" Height="8" Margin="12,0" Minimum="0" Maximum="10" Value="{Binding BorrowCount}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BorrowCount}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Live Snapshot" Style="{StaticResource SectionText}"/>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Active loans" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding ActiveLoans}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,12"/>
                            <TextBlock Text="Estimated fines" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding TotalFines, StringFormat={}{0:N0} đ}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,12"/>
                            <TextBlock Text="Availability rate" Style="{StaticResource MutedText}"/><ProgressBar Height="10" Maximum="100" Value="{Binding AvailabilityRate}" Margin="0,7,0,2"/>
                            <TextBlock Text="Dữ liệu được đọc trực tiếp từ SQL Server" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

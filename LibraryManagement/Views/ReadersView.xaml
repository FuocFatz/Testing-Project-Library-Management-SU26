<UserControl x:Class="LibraryManagement.Views.ReadersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Readers" Style="{StaticResource TitleText}"/><TextBlock Text="Quản lý thẻ thành viên và thông tin liên hệ" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBox Width="300" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0"><DataGrid ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding ReaderId}" Width="55"/><DataGridTextColumn Header="CARD" Binding="{Binding CardNumber}" Width="115"/><DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="DOB" Binding="{Binding DateOfBirth, StringFormat=dd/MM/yyyy}" Width="95"/><DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="115"/><DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="180"/><DataGridTextColumn Header="REGISTERED" Binding="{Binding RegisteredAt, StringFormat=dd/MM/yyyy}" Width="95"/></DataGrid.Columns></DataGrid></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Grid Margin="0,0,0,8"><TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionText}"/><Button Content="+ New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,7"/></Grid><TextBlock Text="Mã thẻ" Style="{StaticResource MutedText}"/><TextBox Text="{Binding CardNumber}"/><TextBlock Text="Họ và tên" Style="{StaticResource MutedText}"/><TextBox Text="{Binding FullName}"/><TextBlock Text="Ngày sinh (dd/MM/yyyy)" Style="{StaticResource MutedText}"/><TextBox Text="{Binding DateOfBirth}"/><TextBlock Text="Số điện thoại" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Phone}"/><TextBlock Text="Email" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Email}"/><TextBlock Text="Địa chỉ" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Address}" AcceptsReturn="True" Height="65" TextWrapping="Wrap"/><Button Content="Save Reader" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,6,0,8"/><Button Content="Disable Reader" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/></StackPanel></ScrollViewer></Border>
        </Grid>
    </Grid>
</UserControl>

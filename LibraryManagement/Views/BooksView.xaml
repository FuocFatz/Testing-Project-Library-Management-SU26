<UserControl x:Class="LibraryManagement.Views.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <StackPanel><TextBlock Text="Books" Style="{StaticResource TitleText}"/><TextBlock Text="Quản lý danh mục, tồn kho và vị trí sách" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBox Width="310" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tìm theo tên, tác giả hoặc ISBN"/>
                <Button Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                <DataGrid ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding BookId}" Width="50"/>
                        <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"/>
                        <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="AUTHOR" Binding="{Binding Author}" Width="150"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category.Name}" Width="110"/>
                        <DataGridTextColumn Header="STOCK" Binding="{Binding Quantity}" Width="65"/>
                        <DataGridTextColumn Header="AVAILABLE" Binding="{Binding AvailableQuantity}" Width="82"/>
                        <DataGridTextColumn Header="SHELF" Binding="{Binding ShelfLocation}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8"><TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionText}"/><Button Content="+ New" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,7"/></Grid>
                        <TextBlock Text="ISBN" Style="{StaticResource MutedText}"/><TextBox Text="{Binding ISBN, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Tên sách" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Tác giả" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Nhà xuất bản" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Thể loại" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Năm XB" Style="{StaticResource MutedText}"/><TextBox Text="{Binding PublishYear}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Số lượng" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Quantity}"/></StackPanel></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Giá" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Price}"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Kệ" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Shelf}"/></StackPanel></Grid>
                        <Button Content="Save Book" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,6,0,8"/>
                        <Button Content="Disable Book" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
                        <Border Background="#0D1626" Padding="12" Margin="0,16,0,0" CornerRadius="10"><StackPanel><TextBlock Text="Inventory snapshot" FontWeight="SemiBold"/><TextBlock Text="{Binding StockCount, StringFormat={}Total copies: {0}}" Style="{StaticResource MutedText}" Margin="0,5,0,0"/><TextBlock Text="{Binding AvailableCount, StringFormat={}Available copies: {0}}" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

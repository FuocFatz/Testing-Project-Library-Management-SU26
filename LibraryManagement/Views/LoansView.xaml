<UserControl x:Class="LibraryManagement.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="Borrow &amp; Return" Style="{StaticResource TitleText}"/><TextBlock Text="Quản lý luồng mượn – trả và tự động tính phạt quá hạn" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel><TextBlock Text="{Binding ActiveSummary}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Create Loan" Style="{StaticResource SectionText}"/><TextBlock Text="Độc giả" Style="{StaticResource MutedText}" Margin="0,16,0,0"/><ComboBox ItemsSource="{Binding Readers}" SelectedItem="{Binding SelectedReader}" DisplayMemberPath="FullName"/><TextBlock Text="Sách" Style="{StaticResource MutedText}"/><ComboBox ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}" DisplayMemberPath="Title"/><TextBlock Text="Hạn trả" Style="{StaticResource MutedText}"/><DatePicker SelectedDate="{Binding DueDate}" Margin="0,6,0,12" Background="#0D1524" Foreground="#EDF3FF"/><TextBlock Text="Ghi chú" Style="{StaticResource MutedText}"/><TextBox Text="{Binding Note}" AcceptsReturn="True" Height="75" TextWrapping="Wrap"/><Button Content="Create Borrow Slip" Command="{Binding BorrowCommand}" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"/><Border Background="#0D1626" CornerRadius="10" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="Business Rules" FontWeight="SemiBold"/><TextBlock Text="• Chỉ cho mượn khi AvailableQuantity &gt; 0" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="• Tự chuyển trạng thái khi quá hạn" Style="{StaticResource MutedText}"/><TextBlock Text="• Phạt 5.000đ / ngày khi trả trễ" Style="{StaticResource MutedText}"/></StackPanel></Border></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Loan History" Style="{StaticResource SectionText}"/><ComboBox SelectedValue="{Binding Filter}" SelectedValuePath="Content" Width="130" HorizontalAlignment="Right" Margin="18,0,0,0"><ComboBoxItem Content="Tất cả" IsSelected="True"/><ComboBoxItem Content="Đang mượn"/><ComboBoxItem Content="Quá hạn"/><ComboBoxItem Content="Đã trả"/></ComboBox><Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Padding="11,7" Margin="10,0,0,0"/></StackPanel><DataGrid ItemsSource="{Binding Loans}" SelectedItem="{Binding SelectedLoan}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="LOAN" Binding="{Binding LoanCode}" Width="130"/><DataGridTextColumn Header="READER" Binding="{Binding Reader.FullName}" Width="*"/><DataGridTextColumn Header="BOOK" Binding="{Binding Details[0].Book.Title}" Width="*"/><DataGridTextColumn Header="BORROWED" Binding="{Binding BorrowedAt, StringFormat=dd/MM/yyyy}" Width="90"/><DataGridTextColumn Header="DUE" Binding="{Binding DueDate, StringFormat=dd/MM/yyyy}" Width="90"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="95"/><DataGridTextColumn Header="FINE" Binding="{Binding FineAmount, StringFormat={}{0:N0} đ}" Width="105"/></DataGrid.Columns></DataGrid><Button Content="Return Selected Loan" Command="{Binding ReturnCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,9"/></DockPanel></Border>
        </Grid>
    </Grid>
</UserControl>
